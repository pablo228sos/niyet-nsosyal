# Firebase Admin (server only; never expose these values to browser code)
# FIREBASE_PRIVATE_KEY must contain the service-account private_key; Vercel may store newlines as \n.
FIREBASE_PROJECT_ID=drsk-web
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@drsk-web.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=

# Public Firebase Web app configuration (served by /api/niyet?action=config)
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=drsk-web.firebaseapp.com
FIREBASE_APP_ID=
FIREBASE_STORAGE_BUCKET=drsk-web.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=

# Optional local emulator endpoint, for example 127.0.0.1:8080
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
